# CJdropshipping API credentials (https://developers.cjdropshipping.com/)
# Never commit real values - this file only documents the expected variable.
#
# Paste the full API key CJ gives you on the "Get API Key" page, in the form
# "<userNum>@api@<secret>" - sent as-is to CJ's getAccessToken endpoint.
CJ_API_KEY_RAW=

# Order confirmation emails (https://resend.com/) - see README "אימיילים ללקוחות".
# Get an API key at resend.com/api-keys after verifying a domain you own.
RESEND_API_KEY=

# Must be an address on the domain you verified in Resend, e.g.:
# EMAIL_FROM="קמפאיזי" <orders@yourdomain.com>
EMAIL_FROM=

# Your real inbox - set as reply-to + bcc on every order email, so replies
# land with you directly and you see every order as it comes in.
STORE_OWNER_EMAIL=
